// TerraGuessr presentation overlay (Phase 4)
// Palette mirrors ZoneIdentity.js (sources/Game/World/ZoneIdentity.js),
// itself sourced from the real TerraGuessr app's styles/index.css.

space = #14112a
space-deep = #0e0b20
space-light = #352d64
cream = #fbf7ee
lime = #c0f66b
lime-light = #d7ff96

.presentation
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index 20
    pointer-events none
    opacity 0
    visibility hidden
    transition opacity 0.4s ease, visibility 0.4s ease
    font-family "Nunito", sans-serif
    color cream

    &.is-visible
        opacity 1
        visibility visible

    &__scrim
        position absolute
        inset 0
        background linear-gradient(115deg, alpha(space-deep, 0.88) 0%, alpha(space-light, 0.55) 38%, alpha(space-light, 0) 62%)

    &__stations
        position absolute
        top 28px
        left 50%
        transform translateX(-50%)
        display flex
        gap 10px
        pointer-events auto

        @media only screen and (max-width 640px)
            top 14px
            gap 6px

    &__station-dot
        display flex
        align-items center
        gap 8px
        padding 8px 14px
        border-radius 999px
        border 1px solid alpha(cream, 0.25)
        background alpha(space-deep, 0.55)
        color alpha(cream, 0.6)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.8rem
        letter-spacing 0.02em
        cursor pointer
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

        .presentation__station-index
            opacity 0.6

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color cream

        &.is-active
            border-color var(--accent, lime)
            color cream
            background alpha(space-light, 0.65)

            .presentation__station-index
                color var(--accent, lime)
                opacity 1

        @media only screen and (max-width 640px)
            padding 6px 10px
            font-size 0.7rem

            .presentation__station-title
                display none

    &__stage
        position absolute
        left 7%
        bottom 16%
        max-width 620px
        padding-right 24px

        @media only screen and (max-width 900px)
            left 5%
            right 5%
            bottom 22%
            max-width none

    // Data-dense layouts (tables, galleries, multi-column grids) get a much
    // roomier stage - set as a `data-density` flag on the root `.presentation`
    // element (SlideRenderer.fillStage, same pattern as `data-layout` /
    // `data-flow`), not on `.presentation__stage` itself.
    &[data-density="wide"]
        .presentation__stage
            left 6%
            right 6%
            top 13%
            bottom 10%
            max-width 1360px
            margin 0 auto
            padding-right 0
            max-height none
            overflow-y auto

            @media only screen and (max-width 900px)
                top 10%
                bottom 16%

    // Title (01) and Abschluss (21) are the two emotional full-bleed
    // moments bookending the deck - centered hero composition instead of
    // the informational bottom-left column every other slide uses.
    &[data-layout="title"],
    &[data-layout="conclusion"]
        .presentation__stage
            left 50%
            right auto
            bottom auto
            top 50%
            transform translate(-50%, -50%)
            max-width 820px
            padding-right 0
            text-align center

        .presentation__title
            font-size 3.4rem

        @media only screen and (max-width 640px)
            .presentation__title
                font-size 2.1rem

    &__eyebrow
        --accent lime
        display inline-block
        margin-bottom 0.6em
        padding 4px 14px
        border-radius 999px
        border 1px solid var(--accent)
        color var(--accent)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.85rem
        letter-spacing 0.08em
        text-transform uppercase

    &__title
        margin-bottom 0.35em
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 2.6rem
        line-height 1.08
        text-wrap balance

        @media only screen and (max-width 640px)
            font-size 1.8rem

    &__subtitle
        margin-bottom 0.9em
        font-size 1.15rem
        font-weight 600
        color lime-light
        opacity 0.9

        @media only screen and (max-width 640px)
            font-size 0.95rem

    &__content
        display flex
        flex-direction column
        gap 1em
        font-size 1rem
        line-height 1.45

        @media only screen and (max-width 640px)
            font-size 0.88rem

        // --- shared building blocks, reused across several layouts ---

        .content-list
            display flex
            flex-direction column
            gap 0.5em
            list-style none
            opacity 0.92

            &--compact
                gap 0.3em
                font-size 0.9rem

            li
                position relative
                padding-left 1.1em

                &::before
                    content "—"
                    position absolute
                    left 0
                    opacity 0.6

        .content-note
            opacity 0.85
            font-size 0.92rem

            &--muted
                opacity 0.6
                font-size 0.82rem

            &--callout
                opacity 0.95
                padding 10px 14px
                border-radius 10px
                border 1px solid alpha(lime, 0.35)
                background alpha(space-deep, 0.4)
                font-size 0.85rem

        .content-goals
            display grid
            grid-template-columns repeat(3, 1fr)
            gap 1em

            @media only screen and (max-width 900px)
                grid-template-columns 1fr

        .content-goal
            padding 14px 16px
            border-radius 14px
            border 1px solid alpha(cream, 0.15)
            background alpha(space-deep, 0.3)

            &__number
                display block
                margin-bottom 0.3em
                color lime
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                font-size 0.85rem
                opacity 0.7

            h3
                margin-bottom 0.3em
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.05rem

            p
                font-size 0.88rem
                opacity 0.85

        // --- title (01) ---

        .content-title__byline
            font-size 1.05rem
            opacity 0.8

        // --- agenda (02) ---

        .content-agenda
            display flex
            flex-direction column
            gap 0.6em
            list-style none

            li
                display flex
                align-items baseline
                gap 0.8em
                padding 10px 0
                border-bottom 1px solid alpha(cream, 0.12)

            &__number
                color lime
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                font-size 1rem
                opacity 0.8

            &__label
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 600
                font-size 1.05rem

            &__detail
                margin-left auto
                opacity 0.65
                font-size 0.85rem
                text-align right

        // --- team (05) ---

        .content-team
            display grid
            grid-template-columns repeat(2, 1fr)
            gap 1em

            @media only screen and (max-width 900px)
                grid-template-columns 1fr

        .content-speaker
            --accent lime
            display flex
            gap 14px
            padding 16px
            border-radius 14px
            border 1px solid alpha(cream, 0.15)
            background alpha(space-deep, 0.3)

            &__initials
                display flex
                align-items center
                justify-content center
                flex-shrink 0
                width 44px
                height 44px
                border-radius 50%
                border 1.5px solid var(--accent)
                color var(--accent)
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700

            h3
                margin-bottom 0.15em
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.05rem

            &__role
                margin-bottom 0.4em
                color lime-light
                font-size 0.85rem
                opacity 0.9

            &__packages
                display flex
                flex-direction column
                gap 0.2em
                list-style none
                font-size 0.8rem
                opacity 0.75

                li
                    position relative
                    padding-left 0.9em

                    &::before
                        content "·"
                        position absolute
                        left 0

        // --- media (07-09) / audience challenge (10) ---

        .content-gallery
            display grid
            grid-template-columns repeat(auto-fit, minmax(220px, 1fr))
            gap 14px

            figure
                margin 0

            img
                display block
                width 100%
                height auto
                border-radius 10px
                border 1px solid alpha(cream, 0.15)

            figcaption
                margin-top 0.35em
                opacity 0.5
                font-size 0.72rem

        .content-challenge
            display flex
            flex-direction column
            gap 1em

            &__figure
                margin 0

                img
                    display block
                    width 100%
                    max-height 56vh
                    object-fit contain
                    border-radius 12px
                    border 1px solid alpha(cream, 0.15)

                figcaption
                    margin-top 0.4em
                    opacity 0.5
                    font-size 0.75rem

        // --- tech stack (12) ---

        .content-stack__grid
            display grid
            grid-template-columns repeat(3, 1fr)
            gap 1em

            @media only screen and (max-width 900px)
                grid-template-columns 1fr

        .content-stack__card
            padding 16px
            border-radius 14px
            border 1px solid alpha(cream, 0.15)
            background alpha(space-deep, 0.3)

            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.05rem

            &__subtitle
                margin-bottom 0.4em
                opacity 0.6
                font-size 0.82rem

        .content-pills
            display flex
            flex-wrap wrap
            gap 6px
            list-style none

            li
                padding 4px 12px
                border-radius 999px
                border 1px solid alpha(cream, 0.25)
                font-size 0.78rem
                opacity 0.85

            &--quality li
                border-color alpha(lime, 0.4)

        // --- architecture flow (13) ---

        .content-steps
            display grid
            grid-template-columns repeat(auto-fit, minmax(190px, 1fr))
            gap 12px
            list-style none

        .content-step
            padding 14px
            border-radius 12px
            border 1px solid alpha(cream, 0.15)
            background alpha(space-deep, 0.3)
            border-top 3px solid alpha(lime, 0.5)

            &[data-actor="Backend"]
                border-top-color #ffb45e

            &[data-actor="Datenbank"]
                border-top-color #57c4e8

            &__number
                display block
                margin-bottom 0.2em
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                opacity 0.5

            &__actor
                display block
                margin-bottom 0.3em
                color lime-light
                font-size 0.72rem
                text-transform uppercase
                letter-spacing 0.06em
                opacity 0.8

            h3
                margin-bottom 0.25em
                font-size 0.95rem

            p
                font-size 0.8rem
                opacity 0.8

        // --- tables: plan/ist (14), challenges (15), audit (18) ---

        .content-table-wrap
            overflow-x auto

        .content-table
            width 100%
            border-collapse collapse
            font-size 0.85rem

            th, td
                padding 8px 12px
                border-bottom 1px solid alpha(cream, 0.12)
                text-align left
                vertical-align top

            th
                color lime-light
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 600
                font-size 0.75rem
                text-transform uppercase
                letter-spacing 0.04em
                opacity 0.8

            tr.is-critical td
                background alpha(#ff6b6b, 0.08)

        .content-source
            opacity 0.5
            font-size 0.72rem

        .content-badge
            display inline-block
            padding 3px 10px
            border-radius 999px
            font-size 0.75rem
            font-weight 600
            white-space nowrap

            &[data-status="bestanden"], &[data-status="gelöst"]
                border 1px solid alpha(lime, 0.5)
                color lime-light

            &[data-status="teilweise"], &[data-status="in Arbeit"]
                border 1px solid alpha(#ffb45e, 0.5)
                color #ffb45e

            &[data-status="nicht bestanden"], &[data-status="offen"]
                border 1px solid alpha(#ff6b6b, 0.6)
                color #ff9b9b

        // --- audit summary stats (18) ---

        .content-audit__summary
            display grid
            grid-template-columns repeat(4, 1fr)
            gap 10px
            margin-bottom 0.4em

            @media only screen and (max-width 640px)
                grid-template-columns repeat(2, 1fr)

        .content-stat
            padding 12px
            border-radius 12px
            border 1px solid alpha(cream, 0.15)
            text-align center

            &__value
                display block
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                font-size 1.4rem
                color lime

            &__label
                font-size 0.72rem
                opacity 0.65

        // --- testing tiers (19) ---

        .content-tiers
            display grid
            grid-template-columns repeat(3, 1fr)
            gap 1em

            @media only screen and (max-width 900px)
                grid-template-columns 1fr

        .content-tier
            padding 14px
            border-radius 12px
            border 1px solid alpha(cream, 0.15)
            background alpha(space-deep, 0.3)

            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.95rem

            &__tool
                opacity 0.6
                font-size 0.78rem

            &__result
                margin 0.3em 0
                color lime-light
                font-weight 700

        // --- live demo (20) ---

        .content-demo__steps
            display flex
            flex-wrap wrap
            gap 10px
            list-style none

            li
                display flex
                align-items center
                gap 8px
                padding 8px 14px
                border-radius 999px
                border 1px solid alpha(cream, 0.2)
                font-size 0.85rem

                span
                    color lime
                    font-family "Fredoka", ui-rounded, sans-serif
                    font-weight 700

        // --- conclusion (21) ---

        .content-conclusion__lines
            display flex
            flex-direction column
            gap 0.1em
            margin-bottom 0.5em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 2.6rem
            line-height 1.1

            span
                color lime-light

        .content-conclusion__subline
            margin-bottom 1em
            opacity 0.8
            font-size 1.05rem

        .content-conclusion__columns
            display grid
            grid-template-columns repeat(2, 1fr)
            gap 1.5em
            margin-bottom 1em
            text-align left

            h3
                margin-bottom 0.4em
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.95rem
                color lime-light

            @media only screen and (max-width 640px)
                grid-template-columns 1fr

        .content-conclusion__closing
            display flex
            justify-content center
            gap 0.6em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 2.2rem
            color lime

    &__hints
        position absolute
        right 24px
        bottom 20px
        display flex
        flex-direction column
        align-items flex-end
        gap 4px
        font-size 0.72rem
        letter-spacing 0.02em
        color alpha(cream, 0.45)

        i
            font-style normal
            padding 1px 6px
            margin 0 2px
            border-radius 5px
            border 1px solid alpha(cream, 0.3)
            font-weight 600

        @media only screen and (max-width 640px)
            display none

    &__close
        position absolute
        top 24px
        right 24px
        display none
        align-items center
        justify-content center
        width 40px
        height 40px
        border-radius 50%
        border 1px solid alpha(cream, 0.3)
        background alpha(space-deep, 0.55)
        color cream
        font-size 1.5rem
        line-height 1
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color lime-light

        @media only screen and (max-width 640px)
            top 14px
            right 14px
            width 34px
            height 34px
            font-size 1.25rem

    &__section-nav
        display flex
        align-items center
        gap 1em
        margin-top 1em

    &__section-count
        font-size 0.8rem
        font-weight 600
        letter-spacing 0.03em
        color alpha(cream, 0.55)

    &__finish
        display none
        align-items center
        gap 8px
        padding 10px 20px
        border-radius 999px
        border 1.5px solid var(--accent, lime)
        background alpha(space-deep, 0.4)
        color cream
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.85rem
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, background 0.2s ease, transform 0.2s ease

        &.is-visible
            display inline-flex

        html:not(.is-mode-touch) &:hover
            background alpha(space-light, 0.6)
            transform translateY(-1px)

    // Mode-specific chrome: tour (automated, all stations) vs. station
    // (one stand opened by walking up and pressing the interact key).
    &[data-flow="station"]
        .presentation__close
            display flex

        .presentation__stations
            display none

        .presentation__hint--tour
            display none

    &[data-flow="tour"]
        .presentation__close
            display none

        .presentation__section-nav
            display none

        .presentation__hint--station
            display none

.station-prompt
    position fixed
    left 50%
    bottom 11%
    transform translate(-50%, 10px)
    z-index 15
    display flex
    align-items center
    gap 10px
    padding 10px 18px
    border-radius 999px
    border 1px solid alpha(cream, 0.3)
    background alpha(space-deep, 0.72)
    color cream
    font-family "Nunito", sans-serif
    font-weight 600
    font-size 0.95rem
    pointer-events none
    opacity 0
    transition opacity 0.25s ease, transform 0.25s ease
    --accent lime

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

    &__key
        display flex
        align-items center
        justify-content center
        width 26px
        height 26px
        border-radius 8px
        border 1.5px solid var(--accent)
        color var(--accent)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 0.85rem

    @media only screen and (max-width 640px)
        bottom 16%
        font-size 0.8rem
        padding 8px 14px

        &__key
            width 22px
            height 22px
