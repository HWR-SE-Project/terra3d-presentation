// =============================================================================
// TerraGuessr presentation overlay — Phase 6 art direction
//
// Palette mirrors the real TerraGuessr app (frontend/src/styles/index.css) and
// ZoneIdentity.js: deep indigo-violet space, warm cream ink, a confident lime
// brand accent plus sky/amber/violet secondaries. Surfaces are warm and solid
// (layered soft shadows, hairline light borders) — never glassmorphism.
// =============================================================================

space950 = #090718
space900 = #0e0b20
space850 = #14112a
space800 = #1a1636
space700 = #221c41
space600 = #2b2452
space500 = #352d64
cream = #fbf7ee
muted = #bdb5d8
subtle = #948bac
lime300 = #d7ff96
lime400 = #c0f66b
lime500 = #a8e04e
lime600 = #86c334
ink = #1b2a10
amber = #ffb45e
sky = #57c4e8
violet = #9d7dff
rose = #f27f88

shadow-card = 0 12px 32px alpha(#050310, 0.45), 0 2px 6px alpha(#050310, 0.3)
shadow-panel = 0 26px 60px alpha(#050310, 0.55), 0 3px 10px alpha(#050310, 0.32)
hairline = 1px solid alpha(#ffffff, 0.1)

.presentation
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index 20
    pointer-events none
    opacity 0
    visibility hidden
    transition opacity 0.4s ease, visibility 0.4s ease
    font-family "Nunito", sans-serif
    color cream
    --accent lime400
    --accent-rgb 192, 246, 107

    &.is-visible
        opacity 1
        visibility visible

    // Neutralise the host app's global list chrome (general.styl) — every
    // list inside the deck supplies its own spacing, markers and geometry.
    ul
    ol
        margin 0
        padding 0

    // --- background treatment ------------------------------------------------

    &__scrim
        position absolute
        inset 0
        background radial-gradient(115% 90% at 82% 8%, alpha(space600, 0.5) 0%, transparent 52%), linear-gradient(158deg, alpha(space950, 0.98) 0%, alpha(space900, 0.95) 42%, alpha(space850, 0.92) 100%)

    &__pattern
        position absolute
        inset 0
        background-image radial-gradient(alpha(cream, 0.055) 1.1px, transparent 1.1px)
        background-size 28px 28px
        opacity 0.5
        pointer-events none

    &__watermark
        position absolute
        right 6px
        bottom -0.12em
        z-index 1
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 34rem
        line-height 0.8
        color alpha(cream, 0.035)
        pointer-events none
        user-select none

    // --- chrome --------------------------------------------------------------

    &__stations
        position absolute
        top 30px
        left 50%
        transform translateX(-50%)
        display flex
        gap 10px
        pointer-events auto
        z-index 3

        @media only screen and (max-width 640px)
            top 14px
            gap 6px

    &__station-dot
        display flex
        align-items center
        gap 8px
        padding 8px 15px
        border-radius 999px
        border hairline
        background alpha(space900, 0.6)
        color alpha(cream, 0.62)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.8rem
        letter-spacing 0.02em
        cursor pointer
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease, transform 0.2s ease

        .presentation__station-index
            opacity 0.6

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color cream
            transform translateY(-1px)

        &.is-active
            border-color var(--accent, lime400)
            color cream
            background alpha(space600, 0.6)

            .presentation__station-index
                color var(--accent, lime400)
                opacity 1

        @media only screen and (max-width 640px)
            padding 6px 10px
            font-size 0.7rem

            .presentation__station-title
                display none

    &__close
        position absolute
        top 26px
        right 26px
        z-index 3
        display none
        align-items center
        justify-content center
        width 42px
        height 42px
        border-radius 50%
        border hairline
        background alpha(space900, 0.6)
        color cream
        font-size 1.5rem
        line-height 1
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color lime300

        @media only screen and (max-width 640px)
            top 14px
            right 14px
            width 34px
            height 34px
            font-size 1.25rem

    &__hints
        position absolute
        right 26px
        bottom 22px
        z-index 3
        display flex
        flex-direction column
        align-items flex-end
        gap 4px
        font-size 0.72rem
        letter-spacing 0.02em
        color alpha(cream, 0.4)

        i
            font-style normal
            padding 1px 6px
            margin 0 2px
            border-radius 5px
            border 1px solid alpha(cream, 0.28)
            font-weight 600

        @media only screen and (max-width 640px)
            display none

    &__section-nav
        display flex
        align-items center
        gap 1em
        margin-top auto
        padding-top 1.2em

    &__section-count
        font-size 0.8rem
        font-weight 600
        letter-spacing 0.03em
        color alpha(cream, 0.5)

    &__finish
        display none
        align-items center
        gap 8px
        padding 11px 22px
        border-radius 999px
        border 1.5px solid var(--accent, lime400)
        background alpha(space900, 0.4)
        color cream
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.85rem
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, background 0.2s ease, transform 0.2s ease

        &.is-visible
            display inline-flex

        html:not(.is-mode-touch) &:hover
            background alpha(space600, 0.6)
            transform translateY(-1px)

    // --- stage & header ------------------------------------------------------

    &__stage
        position absolute
        inset 0
        z-index 2
        padding 64px 72px
        display flex

        @media only screen and (max-width 900px)
            padding 56px 36px 80px

        @media only screen and (max-width 640px)
            padding 44px 20px 76px

    &__stage-inner
        width 100%
        display flex
        flex-direction column
        align-items flex-start

    // wide layouts centre the content block within the viewport
    &[data-density="wide"]
        .presentation__stage
            align-items stretch

        .presentation__stage-inner
            max-width 1320px
            margin 0 auto
            width 100%
            justify-content flex-start

    &__eyebrow
        display inline-flex
        align-items center
        gap 12px
        margin-bottom 0.7em
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.82rem
        letter-spacing 0.16em
        text-transform uppercase
        color var(--accent, lime400)

        &::before
            content ""
            width 30px
            height 2px
            border-radius 2px
            background var(--accent, lime400)

    &__title
        margin-bottom 0.3em
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size clamp(2rem, 4.2vw, 3.2rem)
        line-height 1.04
        letter-spacing 0.01em
        text-wrap balance

    &__subtitle
        margin-bottom 1.1em
        font-size 1.1rem
        font-weight 600
        color muted

    &__content
        width 100%
        font-size 1rem
        line-height 1.5

    // --- shared primitives ----------------------------------------------------

    .list
        display flex
        flex-direction column
        gap 0.5em
        list-style none
        opacity 0.94

        &--compact
            gap 0.34em
            font-size 0.9rem
            opacity 0.88

        li
            position relative
            padding-left 1.15em

            &::before
                content ""
                position absolute
                left 0
                top 0.62em
                width 6px
                height 6px
                border-radius 2px
                background var(--accent, lime400)
                transform rotate(45deg)

    .note
        opacity 0.86
        font-size 0.92rem

        &--muted
            opacity 0.6
            font-size 0.84rem

        &--callout
            opacity 0.96
            padding 13px 18px
            border-radius 16px
            border-left 3px solid var(--accent, lime400)
            background alpha(space900, 0.5)
            font-size 0.86rem

    .pill
        display inline-block
        padding 5px 13px
        border-radius 999px
        border 1px solid alpha(cream, 0.22)
        background alpha(space800, 0.5)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 500
        font-size 0.8rem
        letter-spacing 0.01em
        color cream
        white-space nowrap

    .badge
        display inline-block
        padding 3px 11px
        border-radius 999px
        font-size 0.74rem
        font-weight 700
        white-space nowrap
        letter-spacing 0.01em

        &[data-status="bestanden"], &[data-status="gelöst"]
            background alpha(lime500, 0.14)
            border 1px solid alpha(lime400, 0.55)
            color lime300

        &[data-status="teilweise"], &[data-status="in Arbeit"]
            background alpha(amber, 0.14)
            border 1px solid alpha(amber, 0.5)
            color #ffc88a

        &[data-status="nicht bestanden"], &[data-status="offen"]
            background alpha(rose, 0.14)
            border 1px solid alpha(rose, 0.55)
            color #ff9da3

    .shot
        margin 0

        img
            display block
            width 100%
            height auto
            border-radius 18px
            border hairline
            box-shadow shadow-card

        figcaption
            margin-top 0.45em
            opacity 0.5
            font-size 0.74rem

    // ==========================================================================
    // Title (01)
    // ==========================================================================

    &[data-layout="title"]
        .presentation__stage
            align-items center
            justify-content center
            text-align center

        .presentation__stage-inner
            align-items center

        .presentation__eyebrow,
        .presentation__title,
        .presentation__subtitle
            display none

        .presentation__content
            max-width 900px

        .hero--title
            display flex
            flex-direction column
            align-items center
            gap 0.3em

        .hero__eyebrow
            margin-bottom 0.2em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 600
            font-size 0.9rem
            letter-spacing 0.22em
            text-transform uppercase
            color muted

        .hero__earth
            margin 0.2em 0 0.1em
            filter drop-shadow(0 24px 50px alpha(lime400, 0.12))

        .hero__title
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size clamp(3.4rem, 9vw, 7.4rem)
            line-height 0.98
            letter-spacing 0.01em
            color cream

        .hero__subtitle
            font-size clamp(1.2rem, 2.2vw, 1.6rem)
            font-weight 600
            color lime300

        .hero__byline
            margin-top 0.6em
            font-size 1rem
            color muted
            letter-spacing 0.02em

    // ==========================================================================
    // Agenda (02)
    // ==========================================================================

    &[data-layout="agenda"]
        .presentation__stage
            align-items center

        .presentation__stage-inner
            align-items center
            text-align center

        .presentation__eyebrow
            &::before
                display none

        .presentation__content
            max-width 1200px
            margin-top 1em

        .route
            position relative
            width 100%

        .route__line
            position absolute
            top 35px
            left 12.5%
            right 12.5%
            height 2px
            background linear-gradient(90deg, unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.10)"), unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.70)"), unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.10)"))
            z-index 0

            @media only screen and (max-width 900px)
                display none

        .route__stops
            position relative
            z-index 1
            display grid
            grid-template-columns repeat(4, minmax(0, 1fr))
            gap 16px
            list-style none
            margin 0

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
                row-gap 34px

            @media only screen and (max-width 640px)
                grid-template-columns minmax(0, 1fr)

        .route__stop
            display flex
            flex-direction column
            align-items center
            gap 8px
            padding 0 10px

        .route__glyph
            display flex
            align-items center
            justify-content center
            width 70px
            height 70px
            border-radius 50%
            background space900
            border 1px solid alpha(cream, 0.16)
            box-shadow shadow-card

            svg
                width 44px
                height 44px

        .route__index
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 0.82rem
            letter-spacing 0.1em
            color var(--accent, lime400)

        .route__label
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 600
            font-size 1.12rem
            line-height 1.15

        .route__detail
            font-size 0.82rem
            color muted
            line-height 1.35

    // ==========================================================================
    // Chapter dividers (03, 06, 11, 17)
    // ==========================================================================

    &[data-layout="divider"]
        .presentation__stage
            align-items center

        .presentation__stage-inner
            align-items flex-start

        .presentation__title
            font-size clamp(2.8rem, 7vw, 5.6rem)
            line-height 0.96
            max-width 15ch

        .presentation__subtitle
            font-size 1.15rem

        .presentation__content
            margin-top 1em
            max-width 640px

        .divider
            position relative
            width 100%
            display grid
            grid-template-columns auto minmax(0, 1fr)
            gap 2.5em
            align-items center

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .divider__glyph
            display flex
            align-items center
            justify-content center
            width 150px
            height 150px
            border-radius 28px
            border hairline
            background alpha(space900, 0.5)
            box-shadow shadow-panel

            svg
                width 112px
                height 112px

            @media only screen and (max-width 900px)
                width 110px
                height 110px
                border-radius 22px

        .divider__body
            .list
                font-size 1.05rem
                gap 0.6em
                opacity 0.92

        .divider__number
            position absolute
            right 0
            top 50%
            transform translateY(-50%)
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 22rem
            line-height 0.8
            color alpha(cream, 0.05)
            pointer-events none
            user-select none

    // ==========================================================================
    // Projektidee & Ziele (04)
    // ==========================================================================

    &[data-layout="idea"]
        .idea
            display flex
            flex-direction column
            gap 1.6em
            margin-top 0.4em

        .idea__flow
            display grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            gap 0
            list-style none
            margin 0

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 20px

        .idea__step
            position relative
            padding 0 44px 0 0

            & + .idea__step::before
                content "→"
                position absolute
                left -22px
                top 34px
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.6rem
                color var(--accent, lime400)

            @media only screen and (max-width 900px)
                padding 0 0 0 56px

                & + .idea__step::before
                    left 18px
                    top -10px
                    transform rotate(90deg)

        .idea__icon
            display flex
            align-items center
            justify-content center
            width 52px
            height 52px
            border-radius 16px
            border hairline
            background alpha(space800, 0.6)
            color var(--accent, lime400)
            margin-bottom 14px

        .idea__number
            display block
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 0.8rem
            letter-spacing 0.14em
            color var(--accent, lime400)
            opacity 0.8

        .idea__step h3
            margin 0.2em 0 0.4em
            font-family "Fredoka", ui-rounded, sans-serif
            font-size 1.4rem

        .idea__step p
            font-size 0.92rem
            color muted
            line-height 1.5
            opacity 0.95

        .idea__meta
            display grid
            grid-template-columns minmax(0, 1fr)
            gap 0.6em
            border-top 1px solid alpha(cream, 0.12)
            padding-top 1.4em

        .idea__audience
            font-size 0.96rem
            font-weight 600
            color cream
            opacity 0.9

    // ==========================================================================
    // Team & Rollen (05)
    // ==========================================================================

    &[data-layout="team"]
        .presentation__stage
            align-items center

        .team
            position relative
            margin-top 0.4em

        .team__count
            position absolute
            right 0
            top 50%
            transform translateY(-50%)
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 20rem
            line-height 0.8
            color alpha(cream, 0.045)
            user-select none
            pointer-events none

        .team__members
            position relative
            z-index 1
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 2em
            list-style none
            margin 0

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 1.4em

        .member
            display flex
            gap 22px
            align-items flex-start

        .member__avatar
            flex-shrink 0
            display flex
            align-items center
            justify-content center
            width 84px
            height 84px

        .member__body
            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.6rem
                margin-bottom 0.1em

        .member__role
            color var(--accent, lime400)
            font-weight 600
            font-size 0.9rem
            margin-bottom 0.6em

        .member__packages
            display flex
            flex-wrap wrap
            gap 8px
            list-style none
            margin 0

            li
                padding 6px 13px
                border-radius 999px
                border 1px solid alpha(cream, 0.2)
                font-size 0.8rem
                color muted
                background alpha(space800, 0.5)

    // ==========================================================================
    // Media (07, 08, 09)
    // ==========================================================================

    &[data-layout="media"]
        .presentation__content
            margin-top 0.2em

        // 07 Startbildschirm — hero + annotation rail
        .media--hero
            display grid
            grid-template-columns minmax(0, 1fr) 340px
            gap 28px
            align-items start

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .media__primary
            .shot--primary img
                border-radius 22px

        .media__rail
            display flex
            flex-direction column
            gap 20px

        .callouts
            list-style none
            margin 0
            display flex
            flex-direction column
            gap 16px

            li
                display flex
                gap 14px
                align-items flex-start

            &__n
                flex-shrink 0
                display flex
                align-items center
                justify-content center
                width 30px
                height 30px
                border-radius 50%
                background var(--accent, lime400)
                color ink
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                font-size 0.85rem

            strong
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.98rem
                display block
                margin-bottom 0.2em

            p
                font-size 0.84rem
                color muted
                line-height 1.45

        // 08 Einzelspieler — phases + filmstrip
        .media--filmstrip
            display flex
            flex-direction column
            gap 1.4em

        .phases
            display grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            gap 0
            list-style none
            margin 0

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 18px

        .phase
            position relative
            padding 0 36px 0 0

            & + .phase::before
                content "→"
                position absolute
                left -20px
                top 8px
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.5rem
                color var(--accent, lime400)

            @media only screen and (max-width 900px)
                padding 0 0 0 34px

                & + .phase::before
                    left 10px
                    top -8px
                    transform rotate(90deg)

        .phase__label
            display inline-block
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 1.25rem
            letter-spacing 0.06em
            text-transform uppercase
            color var(--accent, lime400)
            margin-bottom 0.5em

        .phase__steps
            list-style none
            margin 0
            display flex
            flex-direction column
            gap 0.6em

            li
                font-size 0.85rem
                color muted
                line-height 1.45

            strong
                color cream
                font-weight 600

        .media__strip
            display grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            gap 18px

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        // 09 Mehrspieler — versus
        .media--versus
            display flex
            flex-direction column
            gap 1.4em

        .versus
            display grid
            grid-template-columns minmax(0, 1fr) auto minmax(0, 1fr)
            gap 22px
            align-items center

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .versus__side
            display flex
            flex-direction column
            gap 10px

        .versus__caption
            font-size 0.85rem
            color muted
            line-height 1.45

            // reset strong colouring helper if reused
            font-weight 600

        .versus__mark
            display flex
            align-items center
            justify-content center
            width 64px
            height 64px
            border-radius 50%
            border 1px solid alpha(cream, 0.2)
            background alpha(space900, 0.6)
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 1.3rem
            color lime300
            box-shadow shadow-card

            @media only screen and (max-width 900px)
                width 48px
                height 48px
                margin 0 auto
                font-size 1rem

    // ==========================================================================
    // Publikums-Challenge (10)
    // ==========================================================================

    &[data-layout="challenge"]
        .presentation__stage
            align-items center
            justify-content center
            text-align center

        .presentation__stage-inner
            align-items center

        .presentation__content
            max-width 1160px
            width 100%

        .challenge
            position relative

        .challenge__pano
            margin 0

            img
                display block
                width 100%
                max-height 62vh
                object-fit cover
                border-radius 24px
                border hairline
                box-shadow shadow-panel

            figcaption
                position absolute
                left 18px
                bottom 16px
                margin 0
                padding 6px 12px
                border-radius 999px
                background alpha(space900, 0.7)
                font-size 0.72rem
                opacity 0.7

        .challenge__ask
            position absolute
            left 50%
            top 26px
            transform translateX(-50%)
            display flex
            flex-direction column
            align-items center
            gap 4px
            padding 18px 34px
            border-radius 20px
            background alpha(space900, 0.78)
            border 1px solid alpha(cream, 0.18)
            box-shadow shadow-card
            text-align center

            .list
                align-items center
                gap 0.2em

            .list li
                padding-left 0
                font-size 0.88rem
                color muted

                &::before
                    display none

        .challenge__ping
            position absolute
            right -8px
            top -8px
            width 18px
            height 18px
            border-radius 50%
            background var(--accent, lime400)
            box-shadow 0 0 0 0 unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.60)")
            animation challenge-ping 1.8s ease-out infinite

    @keyframes challenge-ping
        0%
            box-shadow 0 0 0 0 unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.55)")
        70%, 100%
            box-shadow 0 0 0 16px unquote("rgba(var(--accent-rgb, 192, 246, 107), 0)")

    // ==========================================================================
    // Technologie-Stack (12)
    // ==========================================================================

    &[data-layout="stack"]
        .stack
            display flex
            flex-direction column
            gap 1.3em
            margin-top 0.4em

        .stack__diagram
            display flex
            flex-direction column
            gap 12px

        .stack__layer
            display grid
            grid-template-columns 200px minmax(0, 1fr)
            gap 24px
            align-items center
            padding 16px 22px
            border-radius 18px
            border 1px solid alpha(cream, 0.12)
            border-left 4px solid var(--layer, lime400)
            background alpha(space900, 0.45)

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 10px

        .stack__layer-head
            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.05rem
                margin-bottom 0.1em

            p
                font-size 0.78rem
                color muted

        .stack__body
            display flex
            flex-direction column
            gap 10px

        .stack__items
            display flex
            flex-wrap wrap
            gap 8px
            align-items center

        .stack__external
            font-size 0.88rem
            color muted
            opacity 0.9

        .stack__quality
            display flex
            flex-wrap wrap
            align-items center
            gap 8px
            font-size 0.88rem
            color muted

    // ==========================================================================
    // Architektur & Ablauf (13)
    // ==========================================================================

    &[data-layout="flow"]
        .flow
            display flex
            flex-direction column
            gap 1em
            margin-top 0.2em

        .flow-diagram
            border-radius 20px
            border hairline
            background alpha(space900, 0.4)
            padding 10px
            box-shadow shadow-card
            max-width 980px

        .flow__legend
            list-style none
            margin 0
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 8px 30px

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .flow__legend-item
            display grid
            grid-template-columns 30px minmax(0, 1fr)
            gap 12px
            align-items start
            padding 6px 0
            border-bottom 1px solid alpha(cream, 0.1)

        .flow__legend-n
            display flex
            align-items center
            justify-content center
            width 28px
            height 28px
            border-radius 50%
            background unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.16)")
            border 1px solid unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.40)")
            color var(--accent, lime400)
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 0.8rem

        .flow__legend-item strong
            font-size 0.82rem
            display block
            margin-bottom 0.12em

        .flow__legend-item p
            font-size 0.76rem
            color muted
            line-height 1.35

        .flow__notes
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 14px

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

    // ==========================================================================
    // Aufwandsschätzung (14)
    // ==========================================================================

    &[data-layout="table-hours"]
        .hours
            display flex
            flex-direction column
            gap 1.4em
            margin-top 0.4em

        .hours__key
            display flex
            gap 24px
            font-size 0.82rem
            color muted

            span
                display flex
                align-items center
                gap 8px

            i
                width 14px
                height 14px
                border-radius 4px

                &.is-plan
                    background alpha(muted, 0.4)

                &.is-ist
                    background var(--accent, lime400)

        .hours__rows
            list-style none
            margin 0
            display flex
            flex-direction column
            gap 14px

        .hours__row
            display grid
            grid-template-columns 300px minmax(0, 1fr) minmax(0, 1fr)
            gap 20px
            align-items center

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 8px

        .hours__label
            font-size 0.92rem
            font-weight 600

        .hours__track
            display flex
            align-items center
            gap 12px
            height 30px

            i
                flex-shrink 0
                height 16px
                width 40%
                border-radius 6px
                background alpha(muted, 0.18)
                border 1px dashed alpha(cream, 0.25)

            &--ist i
                background unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.16)")
                border-color unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.40)")

            em
                font-style normal
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 600
                font-size 1rem
                color muted

    // ==========================================================================
    // Herausforderungen & Lösungen (15)
    // ==========================================================================

    &[data-layout="table-challenges"]
        .challenges
            list-style none
            margin 0
            display flex
            flex-direction column
            gap 14px
            margin-top 0.4em

        .challenges__row
            display grid
            grid-template-columns minmax(0, 1fr) auto minmax(0, 1.4fr) auto
            gap 20px
            align-items center
            padding 18px 22px
            border-radius 18px
            border 1px solid alpha(cream, 0.12)
            background alpha(space900, 0.42)

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 12px
                align-items start

        .challenges__problem
            p
                font-weight 600
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.02rem
                line-height 1.3

        .challenges__tag
            display inline-block
            margin-bottom 0.4em
            font-size 0.68rem
            font-weight 700
            letter-spacing 0.12em
            text-transform uppercase
            color alpha(cream, 0.45)

        .challenges__arrow
            font-family "Fredoka", ui-rounded, sans-serif
            font-size 1.7rem
            color var(--accent, lime400)

            @media only screen and (max-width 900px)
                transform rotate(90deg)

        .challenges__solution
            p
                font-size 0.86rem
                color muted
                line-height 1.5

        .challenges__source
            display block
            margin-top 0.5em
            font-size 0.72rem
            opacity 0.5

        .challenges__status
            justify-self end

    // ==========================================================================
    // Gewonnene Erkenntnisse (16)
    // ==========================================================================

    &[data-layout="learnings"]
        .presentation__content
            margin-top 0.6em

        .learnings
            list-style none
            margin 0
            display grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            gap 2.2em

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)
                gap 1.6em

        .learnings__item
            position relative
            padding-top 0.4em

        .learnings__number
            display block
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 3.4rem
            line-height 1
            color unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.28)")

        .learnings__item h3
            font-family "Fredoka", ui-rounded, sans-serif
            font-size 1.45rem
            line-height 1.15
            margin 0.4em 0 0.5em

        .learnings__item p
            font-size 0.92rem
            color muted
            line-height 1.55

    // ==========================================================================
    // Anforderungsaudit (18)
    // ==========================================================================

    &[data-layout="audit"]
        .audit
            display flex
            flex-direction column
            gap 1.4em
            margin-top 0.3em

        .audit__summary
            display flex
            flex-direction column
            gap 16px

        .audit__bar
            display flex
            height 34px
            border-radius 999px
            overflow hidden
            border hairline
            background alpha(space900, 0.5)

        .audit__seg
            width var(--w)

            &.is-pass
                background lime500
                color ink

            &.is-partial
                background amber

            &.is-fail
                background rose

        .audit__stats
            display grid
            grid-template-columns repeat(4, minmax(0, 1fr))
            gap 12px

            @media only screen and (max-width 640px)
                grid-template-columns repeat(2, minmax(0, 1fr))

        .audit__stat
            display flex
            flex-direction column
            gap 2px
            padding 14px 18px
            border-radius 14px
            border 1px solid alpha(cream, 0.12)
            background alpha(space900, 0.42)

            b
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                font-size 1.7rem
                line-height 1

            em
                font-style normal
                font-size 0.78rem
                color muted

            &.is-pass b
                color lime300

            &.is-partial b
                color amber

            &.is-fail b
                color #ff9da3

            &.is-mandatory b
                color cream

        .audit__cols
            display grid
            grid-template-columns minmax(0, 1fr) 300px
            gap 28px
            align-items start

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .audit__table-wrap
            overflow-x auto
            border-radius 16px
            border hairline
            background alpha(space900, 0.4)

        .audit__table
            width 100%
            border-collapse collapse
            font-size 0.86rem

            th, td
                padding 10px 14px
                border-bottom 1px solid alpha(cream, 0.1)
                text-align left
                vertical-align top

            th
                color muted
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 600
                font-size 0.72rem
                text-transform uppercase
                letter-spacing 0.05em

            tr:last-child td
                border-bottom none

            tr.is-critical td
                background alpha(rose, 0.08)

            .audit__nr
                font-family "Fredoka", ui-rounded, sans-serif
                font-weight 700
                color var(--accent, lime400)
                white-space nowrap

        .audit__critical-tag
            display inline-block
            margin-left 8px
            padding 2px 8px
            border-radius 999px
            background alpha(rose, 0.18)
            border 1px solid alpha(rose, 0.5)
            color #ff9da3
            font-size 0.66rem
            font-weight 700
            letter-spacing 0.06em
            text-transform uppercase

        .audit__method
            display flex
            flex-direction column
            gap 12px

            h4
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.95rem
                color lime300

    // ==========================================================================
    // Testing (19)
    // ==========================================================================

    &[data-layout="testing"]
        .testing
            display flex
            flex-direction column
            gap 1.5em
            margin-top 0.4em

        .tiers
            list-style none
            margin 0
            display grid
            grid-template-columns repeat(3, minmax(0, 1fr))
            gap 18px

            @media only screen and (max-width 900px)
                grid-template-columns minmax(0, 1fr)

        .tiers__tier
            padding 20px 22px
            border-radius 18px
            border 1px solid alpha(cream, 0.12)
            background alpha(space900, 0.45)
            border-top 4px solid var(--accent, lime400)

        .tiers__head
            display flex
            flex-direction column
            align-items flex-start
            gap 3px

            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 1.05rem

        .tiers__tool
            font-size 0.78rem
            color muted

        .tiers__result
            margin 0.5em 0 0.4em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 1.9rem
            color lime300
            line-height 1

        .tiers__note
            font-size 0.8rem
            color muted
            line-height 1.45

        .testing__ci
            h4
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.95rem
                color lime300
                margin-bottom 0.5em

        .testing__caveats
            display flex
            flex-direction column
            gap 10px

    // ==========================================================================
    // Live-Demo (20)
    // ==========================================================================

    &[data-layout="demo"]
        .presentation__stage
            align-items center
            justify-content center
            text-align center

        .presentation__stage-inner
            align-items center

        .presentation__content
            max-width 860px

        .demo
            display flex
            flex-direction column
            align-items center
            gap 1.6em

        .demo__live
            display inline-flex
            align-items center
            gap 14px
            padding 16px 34px
            border-radius 999px
            border 1px solid unquote("rgba(var(--accent-rgb, 192, 246, 107), 0.50)")
            background alpha(space900, 0.6)
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size 2.2rem
            letter-spacing 0.12em
            color lime300
            box-shadow shadow-panel

        .demo__dot
            width 16px
            height 16px
            border-radius 50%
            background lime400
            animation demo-blink 1.4s ease-in-out infinite

        .demo__steps
            list-style none
            margin 0
            display flex
            gap 12px
            flex-wrap wrap
            justify-content center

            li
                display flex
                align-items center
                gap 10px
                padding 12px 20px
                border-radius 999px
                border hairline
                background alpha(space800, 0.5)
                font-size 0.9rem
                font-weight 600

                span
                    color var(--accent, lime400)
                    font-family "Fredoka", ui-rounded, sans-serif
                    font-weight 700

        .demo__notes
            display flex
            flex-direction column
            gap 10px
            text-align left
            width 100%

    @keyframes demo-blink
        0%, 100%
            opacity 0.35
        50%
            opacity 1

    // ==========================================================================
    // Abschluss (21)
    // ==========================================================================

    &[data-layout="conclusion"]
        .presentation__stage
            align-items center
            justify-content center
            text-align center

        .presentation__stage-inner
            align-items center

        .presentation__eyebrow,
        .presentation__title,
        .presentation__subtitle
            display none

        .presentation__content
            max-width 1000px

        .hero--closing
            display flex
            flex-direction column
            align-items center
            gap 0.5em

        .hero__eyebrow
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 600
            font-size 0.9rem
            letter-spacing 0.22em
            text-transform uppercase
            color muted

        .hero__earth
            margin 0.1em 0
            filter drop-shadow(0 20px 44px alpha(lime400, 0.12))

        .hero__lines
            display flex
            flex-wrap wrap
            justify-content center
            gap 0.6em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size clamp(1.9rem, 4.4vw, 3.2rem)
            line-height 1.05

            span
                color lime300

        .hero__subline
            font-size 1.05rem
            color muted
            max-width 60ch
            line-height 1.5

        .hero__columns
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 2em
            width 100%
            text-align left
            margin 0.8em 0 1em

            h3
                font-family "Fredoka", ui-rounded, sans-serif
                font-size 0.95rem
                color lime300
                margin-bottom 0.5em

            .list
                font-size 0.9rem

            @media only screen and (max-width 640px)
                grid-template-columns minmax(0, 1fr)

        .hero__closing
            display flex
            gap 0.7em
            font-family "Fredoka", ui-rounded, sans-serif
            font-weight 700
            font-size clamp(2.2rem, 6vw, 4.4rem)
            color cream

            span + span
                color lime300

    // ==========================================================================
    // Mode-specific chrome (tour vs. station)
    // ==========================================================================

    &[data-flow="station"]
        .presentation__close
            display flex

        .presentation__stations
            display none

        .presentation__hint--tour
            display none

    &[data-flow="tour"]
        .presentation__close
            display none

        .presentation__section-nav
            display none

        .presentation__hint--station
            display none

.station-prompt
    position fixed
    left 50%
    bottom 11%
    transform translate(-50%, 10px)
    z-index 15
    display flex
    align-items center
    gap 10px
    padding 10px 18px
    border-radius 999px
    border 1px solid alpha(cream, 0.3)
    background alpha(space900, 0.72)
    color cream
    font-family "Nunito", sans-serif
    font-weight 600
    font-size 0.95rem
    pointer-events none
    opacity 0
    transition opacity 0.25s ease, transform 0.25s ease
    --accent lime400

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

    &__key
        display flex
        align-items center
        justify-content center
        width 26px
        height 26px
        border-radius 8px
        border 1.5px solid var(--accent)
        color var(--accent)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 0.85rem

    @media only screen and (max-width 640px)
        bottom 16%
        font-size 0.8rem
        padding 8px 14px

        &__key
            width 22px
            height 22px
