// =============================================================================
// TerraGuessr Presentation — Corporate Minimalist Design System
//
// Translates executive presentation architecture (crisp white vs. deep cosmic
// midnight indigo, sharp alignment, generous negative space, slanted accent
// dividers, bottom anchor bands, and minimalist charts) into TerraGuessr's
// authentic brand palette and geographical identity.
//
// Strict discipline: zero gradients, zero glows, zero rounded cards,
// zero decorative icons. Backgrounds stay subtly translucent over the live
// 3D world and become solid matte in print / standalone linear modes.
//
// Note: Host app sets html { font-size: 20px } (1rem = 20px).
// =============================================================================

navy = #0f1021
navy-soft = #181a32
white = #ffffff
mist = #f3f4f8

ink = #121429
ink-body = #3b3f58
ink-muted = #6e738c
ink-subtle = #9499b0

light-ink = #f7f8fc
light-body = #c5c9dc
light-muted = #8388a3
light-subtle = #5f6580

lime = #bae862
lime-mid = #6b9e24
forest = #2b6e35
ocean = #3b6fd4
amber-light = #b85d19
amber-dark = #e5a446

hair-light = rgba(18, 20, 41, 0.12)
hair-light-strong = rgba(18, 20, 41, 0.26)
hair-dark = rgba(247, 248, 252, 0.14)
hair-dark-strong = rgba(247, 248, 252, 0.28)

font-display = "Barlow", "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif
font-body = "DM Sans", "Barlow", -apple-system, BlinkMacSystemFont, sans-serif
font-mono = "IBM Plex Mono", ui-monospace, SFMono-Regular, monospace

.presentation
    position fixed
    inset 0
    z-index 20
    pointer-events none
    opacity 0
    visibility hidden
    transition opacity 0.3s ease, visibility 0.3s ease
    font-family font-body
    color ink
    -webkit-font-smoothing antialiased

    &.is-visible
        opacity 1
        visibility visible

    ul, ol
        margin 0
        padding 0
        list-style none

    // =========================================================================
    // Translucent Matte Backdrops (3D World Subtly Alive Behind Slides)
    // =========================================================================

    &__scrim
        position absolute
        inset 0
        background-color transparent
        transition background-color 0.3s ease

    &[data-theme="dark"]
        color light-ink

        .presentation__scrim
            background-color rgba(15, 16, 33, 0.83)
            backdrop-filter blur(5px)
            -webkit-backdrop-filter blur(5px)

    &[data-theme="light"]
        color ink

        .presentation__scrim
            background-color rgba(255, 255, 255, 0.88)
            backdrop-filter blur(5px)
            -webkit-backdrop-filter blur(5px)

    &[data-theme="split"]
        color ink

        .presentation__scrim
            background-color transparent
            backdrop-filter blur(5px)
            -webkit-backdrop-filter blur(5px)

    // Solid matte surfaces when no 3D canvas is mounted (?print=1 & ?linear=1)
    &[data-flow="print"],
    &[data-standalone="true"]
        .presentation__scrim
            backdrop-filter none
            -webkit-backdrop-filter none

        &[data-theme="dark"] .presentation__scrim
            background-color navy

        &[data-theme="light"] .presentation__scrim
            background-color white

        .split-layout__dark
            background-color navy

        .split-layout__light
            background-color white

        .anchor-band
            background-color navy

    // =========================================================================
    // Minimal Corporate Chrome (Top-Right Wordmark + Quiet Bottom-Right Number)
    // =========================================================================

    &__brand
        position absolute
        top 30px
        right 64px
        z-index 6
        font-family font-display
        font-weight 700
        font-size 0.72rem
        letter-spacing 0.24em
        text-transform uppercase
        pointer-events none
        user-select none
        opacity 0.55

        span
            color ink

        em
            font-style normal
            color forest

    &[data-theme="dark"] &__brand
        opacity 0.72

        span
            color light-ink

        em
            color lime

    &[data-layout="title"] &__brand,
    &[data-layout="qa"] &__brand
        display none

    &__footer-chrome
        position absolute
        right 64px
        bottom 24px
        z-index 6
        pointer-events none

    &__slide-num
        font-family font-display
        font-size 0.78rem
        font-weight 400
        letter-spacing 0.04em
        color ink-subtle
        font-variant-numeric tabular-nums

    &[data-theme="dark"] &__slide-num,
    &[data-layout="agenda"] &__slide-num,
    &[data-layout="goals"] &__slide-num,
    &[data-layout="team"] &__slide-num,
    &[data-layout="hours"] &__slide-num
        color light-muted

    &[data-layout="title"] &__footer-chrome,
    &[data-layout="qa"] &__footer-chrome
        display none

    // =========================================================================
    // Stage & Shared Architectural Primitives
    // =========================================================================

    &__stage
        position absolute
        inset 0
        z-index 2
        display flex

    &__stage-inner,
    &__content
        width 100%
        height 100%
        display flex

    .slide-frame
        width 100%
        height 100%
        display flex
        flex-direction column

    .slide-body
        flex 1
        width 100%
        max-width 1560px
        margin 0 auto
        padding 64px 88px 54px
        display flex
        flex-direction column
        min-height 0

        @media only screen and (max-width 1200px)
            padding 48px 52px 42px

    .slide-frame--with-band
        .slide-body
            padding-bottom 36px

    // Full-bleed dark bottom anchor band (Reference Pages 4, 5, 9)
    .anchor-band
        flex-shrink 0
        width 100%
        background-color rgba(15, 16, 33, 0.92)
        padding 28px 120px
        display flex
        align-items center
        justify-content center
        text-align center

        @media only screen and (max-width 1200px)
            padding 22px 64px

        p
            font-family font-display
            font-weight 400
            font-size clamp(0.95rem, 1.15vw, 1.12rem)
            line-height 1.4
            color lime
            letter-spacing 0.01em
            max-width 88ch
            margin 0

    .slide-head
        margin-bottom clamp(1.5rem, 3.4vh, 2.5rem)
        flex-shrink 0

        &--center
            text-align center

        &__title
            font-family font-display
            font-weight 700
            font-size clamp(2.1rem, 3.1vw, 2.9rem)
            line-height 1.06
            letter-spacing -0.025em
            color ink
            margin 0

        &__subtitle
            font-family font-display
            font-weight 400
            font-size clamp(0.95rem, 1.15vw, 1.12rem)
            color ink-muted
            margin 0.35em 0 0
            line-height 1.35

    &[data-theme="dark"]
        .slide-head__title
            color light-ink

        .slide-head__subtitle
            color light-muted

        .slide-footnote
            color light-muted
            border-top-color hair-dark

    .slide-footnote
        margin-top auto
        padding-top 14px
        border-top 1px solid hair-light
        font-size 0.74rem
        font-weight 400
        color ink-muted
        line-height 1.4

    // Signature slanted lime divider (Reference Pages 12 & 28)
    .slant-divider
        width 1.5px
        height 100%
        min-height 240px
        max-height 460px
        background lime
        opacity 0.85
        transform rotate(7deg)
        align-self center
        justify-self center

    // 3-segment accent underline (Reference Page 14)
    .seg-rule
        display flex
        gap 5px
        width 104px
        height 2.5px
        margin 10px 0 16px

        i
            display block
            flex 1
            height 100%

            &:nth-child(1)
                background lime

            &:nth-child(2)
                background rgba(186, 232, 98, 0.36)

            &:nth-child(3)
                background rgba(247, 248, 252, 0.16)

    // =========================================================================
    // Asymmetric Dark / White Split System (Slides 03, 13, 18)
    // =========================================================================

    .split-layout
        width 100%
        height 100%
        display grid

        &--34
            grid-template-columns 34% 66%

        &--30
            grid-template-columns 30% 70%

        &--38
            grid-template-columns 38% 62%

    .split-layout__dark
        background-color rgba(15, 16, 33, 0.86)
        color light-ink
        padding 72px 58px 64px 80px
        display flex
        flex-direction column
        justify-content center

    .split-layout__light
        background-color rgba(255, 255, 255, 0.89)
        color ink
        padding 72px 88px 64px 80px
        display flex
        flex-direction column
        justify-content center

    .split-rail__label
        font-family font-display
        font-weight 600
        font-size 0.78rem
        letter-spacing 0.18em
        text-transform uppercase
        color lime
        margin-bottom 22px

    .split-rail__headline
        font-family font-display
        font-weight 600
        font-size clamp(1.9rem, 2.7vw, 2.55rem)
        line-height 1.15
        letter-spacing -0.02em
        color light-ink
        margin 0

    .split-rail__rule
        width 64px
        height 2px
        background lime
        margin 28px 0 24px

    .split-rail__clues
        display flex
        flex-direction column
        gap 10px

        li
            font-family font-display
            font-weight 400
            font-size 0.98rem
            color light-body
            padding-left 18px
            position relative

            &::before
                content "—"
                position absolute
                left 0
                color lime

    .split-rail__quote
        margin-top 36px
        font-family font-display
        font-weight 300
        font-size 1.05rem
        color light-muted
        letter-spacing 0.01em

    // =========================================================================
    // 01 — Title (Dark Editorial Hero + Live 3D Origami Globe)
    // =========================================================================

    &[data-layout="title"]
        .hero--title
            width 100%
            height 100%
            display flex
            align-items center
            justify-content center

        .hero__inner
            width 100%
            max-width 1480px
            padding 72px 96px
            display grid
            grid-template-columns minmax(0, 1.3fr) minmax(280px, 0.8fr)
            align-items center
            gap clamp(48px, 6vw, 108px)

        .hero__header
            display flex
            flex-direction column
            align-items flex-start

        .hero__academic
            font-family font-display
            font-weight 500
            font-size 0.76rem
            text-transform uppercase
            letter-spacing 0.22em
            color light-muted
            margin 0 0 22px

        .hero__name
            font-family font-display
            font-weight 800
            font-size clamp(3.8rem, 6.4vw, 5.8rem)
            line-height 0.96
            letter-spacing -0.035em
            margin 0

        .hero__brand-terra
            color light-ink

        .hero__brand-guessr
            color lime

        .hero__tagline
            font-family font-display
            font-weight 300
            font-size clamp(1.5rem, 2.3vw, 2.15rem)
            line-height 1.24
            color light-body
            margin 18px 0 0

        .hero__rule
            width 88px
            height 2px
            background lime
            margin clamp(1.8rem, 4vh, 2.6rem) 0 clamp(1.2rem, 2.6vh, 1.7rem)

        .hero__byline
            font-family font-display
            font-weight 500
            font-size clamp(1rem, 1.2vw, 1.18rem)
            color light-ink
            letter-spacing 0.03em
            margin 0

        .hero__planet-stage
            width clamp(260px, 26vw, 400px)
            height clamp(260px, 26vw, 400px)
            justify-self center
            position relative
            pointer-events none

        .hero__globe-host,
        .hero__globe-canvas,
        .hero__static-earth
            position absolute
            inset 0
            width 100%
            height 100%
            display block

    // =========================================================================
    // 02 — Agenda (Pure White 4-Column Architectural Index + Dark Bottom Bar)
    // =========================================================================

    &[data-layout="agenda"]
        .agenda__grid
            margin auto 0
            display grid
            grid-template-columns repeat(4, minmax(0, 1fr))
            gap 44px

        .agenda__col
            border-top 2px solid ink
            padding-top 22px
            display flex
            flex-direction column

        .agenda__num
            font-family font-display
            font-weight 300
            font-size 3rem
            line-height 1
            color lime-mid
            font-variant-numeric tabular-nums
            margin-bottom 18px

        .agenda__label
            font-family font-display
            font-weight 700
            font-size 1.42rem
            color ink
            margin 0 0 6px
            letter-spacing -0.015em

        .agenda__speaker
            font-family font-display
            font-weight 500
            font-size 0.84rem
            letter-spacing 0.06em
            text-transform uppercase
            color forest
            margin 0 0 20px

        .agenda__topics
            padding-top 16px
            border-top 1px solid hair-light
            display flex
            flex-direction column
            gap 10px

            li
                font-size 0.94rem
                font-weight 400
                color ink-body
                line-height 1.38

    // =========================================================================
    // 05, 10, 14 — Centered Section / Station Dividers (Dark & Light Themes)
    // =========================================================================

    &[data-layout="divider"],
    &[data-layout="divider-light"]
        .divider
            width 100%
            height 100%
            position relative
            overflow hidden
            display flex
            align-items center
            justify-content center
            text-align center

        .divider__inner
            position relative
            z-index 2
            width 100%
            max-width 1520px
            margin 0 auto
            padding 0 96px 2.5vh
            display flex
            flex-direction column
            align-items center
            text-align center

            @media only screen and (max-width 1200px)
                padding 0 56px 2vh

        .divider__kicker
            font-family font-display
            font-weight 600
            font-size clamp(0.84rem, 1vw, 0.98rem)
            line-height 1.2
            letter-spacing 0.26em
            text-transform uppercase
            color forest
            margin 0 0 clamp(2.2rem, 5.2vh, 3.2rem)

        .divider__title
            font-family font-display
            font-weight 800
            font-size clamp(4rem, 7.6vw, 7.4rem)
            line-height 1.02
            letter-spacing -0.025em
            color ink
            margin 0
            text-wrap balance

        .divider__subtitle
            font-family font-display
            font-weight 400
            font-size clamp(1.1rem, 1.44vw, 1.4rem)
            line-height 1.4
            letter-spacing 0.015em
            color ink-muted
            max-width 58ch
            margin clamp(2.4rem, 5.8vh, 3.6rem) 0 0

    &[data-theme="dark"][data-layout="divider"],
    &[data-theme="dark"][data-layout="divider-light"]
        .divider__kicker
            color lime

        .divider__title
            color light-ink

        .divider__subtitle
            color light-body

    // =========================================================================
    // 03 — Split Idea (Reference Page 11 Numbered Rows on White + Dark Rail)
    // =========================================================================

    &[data-layout="split-idea"]
        .num-rows
            margin-top 44px
            display flex
            flex-direction column
            gap 34px

        .num-row
            display grid
            grid-template-columns 72px minmax(0, 1fr)
            gap 22px
            align-items baseline

        .num-row__idx
            font-family font-display
            font-weight 700
            font-size 2.35rem
            line-height 1
            color lime-mid
            font-variant-numeric tabular-nums

        .num-row__body
            font-family font-display
            font-weight 400
            font-size clamp(1.06rem, 1.35vw, 1.26rem)
            line-height 1.46
            color ink-body

            strong
                font-weight 700
                color ink

    // =========================================================================
    // 04 — Goals + Flat Solid Kano KPI Block (Reference Page 4)
    // =========================================================================

    &[data-layout="goals"]
        .goals
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1.65fr) minmax(340px, 0.92fr)
            gap 64px
            align-items center

        .goals__list
            display flex
            flex-direction column
            gap 30px

        .goals__row
            display grid
            grid-template-columns 64px minmax(0, 1fr)
            gap 20px
            align-items baseline
            padding-top 20px
            border-top 1px solid hair-light

            &:first-child
                border-top 2px solid ink

        .goals__idx
            font-family font-display
            font-weight 700
            font-size 1.9rem
            line-height 1
            color lime-mid
            font-variant-numeric tabular-nums

        .goals__copy
            h2
                font-family font-display
                font-weight 700
                font-size 1.32rem
                color ink
                margin 0 0 6px
                letter-spacing -0.015em

            p
                font-size 0.98rem
                font-weight 400
                color ink-body
                line-height 1.45
                margin 0

        .goals__kpi
            background navy
            color light-ink
            padding 36px 36px 32px
            display flex
            flex-direction column
            gap 24px

        .goals__kpi-top
            display flex
            align-items center
            gap 20px

        .goals__kpi-value
            font-family font-display
            font-weight 800
            font-size 4.4rem
            line-height 0.9
            letter-spacing -0.04em
            color lime
            font-variant-numeric tabular-nums

        .goals__kpi-label
            display block
            font-family font-display
            font-weight 700
            font-size 1.22rem
            color light-ink

        .goals__kpi-sub
            display block
            margin-top 4px
            font-family font-display
            font-weight 400
            font-size 0.88rem
            color light-muted

        .kano-bar
            display flex
            height 10px
            width 100%
            gap 2px

        .kano-bar__seg
            height 100%

            &.is-base
                background lime
            &.is-perf
                background ocean
            &.is-delight
                background amber-dark
            &.is-indiff
                background #5c617a

        .kano-legend
            display flex
            flex-direction column
            gap 10px

            li
                display flex
                align-items center
                gap 12px
                font-family font-display
                font-size 0.94rem
                color light-body

        .kano-legend__dot
            width 9px
            height 9px
            flex-shrink 0

            &.is-base
                background lime
            &.is-perf
                background ocean
            &.is-delight
                background amber-dark
            &.is-indiff
                background #5c617a

        .kano-legend__name
            flex 1

        .kano-legend__val
            font-family font-display
            font-weight 700
            color light-ink
            font-variant-numeric tabular-nums

    // =========================================================================
    // 06 — Team & Roles (Unboxed 4-Column Typographic Grid + Dark Anchor Band)
    // =========================================================================

    &[data-layout="team"]
        .team__grid
            margin auto 0
            display grid
            grid-template-columns repeat(4, minmax(0, 1fr))
            gap 40px

        .team__col
            border-top 2px solid ink
            padding-top 22px
            display flex
            flex-direction column

        .team__num
            font-family font-display
            font-weight 300
            font-size 2.5rem
            line-height 1
            color lime-mid
            font-variant-numeric tabular-nums
            margin-bottom 16px

        .team__name
            font-family font-display
            font-weight 700
            font-size 1.55rem
            color ink
            margin 0 0 6px
            letter-spacing -0.02em

        .team__pres
            font-family font-display
            font-weight 600
            font-size 0.92rem
            color forest
            margin 0

        .team__rule
            width 100%
            height 1px
            background hair-light
            margin 18px 0

        .team__proj
            font-size 0.9rem
            font-weight 400
            color ink-body
            line-height 1.48
            margin 0

            &.is-pending
                color ink-muted
                font-style italic

    // =========================================================================
    // 07 — Entry & Setup (Dark Large Side-by-Side Uncropped Screenshots)
    // =========================================================================

    &[data-layout="versus"]
        .versus__grid
            margin auto 0
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 40px
            align-items start

        .versus__col
            display flex
            flex-direction column

        .versus__shot
            margin 0

            img
                display block
                width 100%
                aspect-ratio 2 / 1
                height auto
                object-fit contain
                background navy
                border 1px solid hair-dark-strong

        .versus__caption
            margin-top 20px
            padding-top 16px
            border-top 1px solid hair-dark
            display grid
            grid-template-columns 44px minmax(0, 1fr)
            gap 14px
            align-items baseline

            h2
                font-family font-display
                font-weight 700
                font-size 1.18rem
                color light-ink
                margin 0 0 4px

            p
                font-size 0.92rem
                font-weight 400
                color light-muted
                line-height 1.4
                margin 0

        .versus__step
            font-family font-display
            font-weight 700
            font-size 1.25rem
            color lime
            font-variant-numeric tabular-nums

    // =========================================================================
    // 08 — Singleplayer Product Mosaic (Light Asymmetric Spread, Ref Page 24)
    // =========================================================================

    &[data-layout="product-mosaic"]
        .mosaic
            flex 1
            min-height 0
            display grid
            grid-template-columns minmax(0, 1.54fr) minmax(0, 1fr)
            gap 36px
            align-items center

        .mosaic__main
            margin 0
            display flex
            flex-direction column

            img
                display block
                width 100%
                aspect-ratio 2 / 1
                max-height 56vh
                object-fit contain
                background navy
                border 1px solid hair-light-strong

        .mosaic__main-cap
            margin-top 18px
            padding-top 14px
            border-top 2px solid ink
            display grid
            grid-template-columns 42px minmax(0, 1fr)
            gap 12px
            align-items baseline

            strong
                display block
                font-family font-display
                font-weight 700
                font-size 1.14rem
                color ink
                margin-bottom 3px

            p
                font-size 0.88rem
                color ink-muted
                line-height 1.38
                margin 0

        .mosaic__stack
            display flex
            flex-direction column
            gap 22px

        .mosaic__sub
            margin 0

            img
                display block
                width 100%
                aspect-ratio 2 / 1
                max-height 28vh
                object-fit contain
                background navy
                border 1px solid hair-light-strong

            figcaption
                margin-top 9px
                display flex
                align-items baseline
                gap 10px
                font-family font-display
                font-weight 600
                font-size 0.9rem
                color ink

        .mosaic__step
            font-family font-display
            font-weight 700
            font-size 1rem
            color lime-mid
            font-variant-numeric tabular-nums

    // =========================================================================
    // 09 — Multiplayer & Ecosystem (Dark Split + Slanted Lime Rule, Ref Page 12)
    // =========================================================================

    &[data-layout="showcase"]
        .showcase
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1.62fr) 36px minmax(300px, 0.92fr)
            gap 24px
            align-items center

        .showcase__primary
            margin 0

            img
                display block
                width 100%
                aspect-ratio 2 / 1
                height auto
                object-fit contain
                background navy
                border 1px solid hair-dark-strong

            figcaption
                margin-top 14px
                font-family font-display
                font-weight 400
                font-size 0.9rem
                color light-muted

        .showcase__points
            display flex
            flex-direction column
            gap 28px

        .showcase__point
            h2
                font-family font-display
                font-weight 700
                font-size 1.18rem
                color light-ink
                margin 4px 0 0

            p
                font-size 0.9rem
                font-weight 400
                color light-body
                line-height 1.44
                margin 0

        .showcase__tag
            font-family font-mono
            font-size 0.72rem
            font-weight 500
            color lime
            letter-spacing 0.04em

    // =========================================================================
    // 11 — Architecture & Stack (Dark Minimalist Layered Diagram, Zero Pills)
    // =========================================================================

    &[data-layout="architecture"]
        .arch
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1.68fr) minmax(300px, 0.92fr)
            gap 56px
            align-items start

        .arch__tiers
            display flex
            flex-direction column

        .arch__tier
            border 1px solid hair-dark
            border-left 3px solid lime
            padding 22px 28px
            display grid
            grid-template-columns 52px minmax(0, 1fr)
            gap 20px
            align-items baseline

        .arch__num
            font-family font-display
            font-weight 300
            font-size 1.85rem
            line-height 1
            color lime
            font-variant-numeric tabular-nums

        .arch__info
            h2
                font-family font-display
                font-weight 700
                font-size 1.28rem
                color light-ink
                margin 0 0 4px

        .arch__role
            font-size 0.9rem
            color light-body
            margin 0 0 10px
            line-height 1.38

        .arch__stack
            font-family font-mono
            font-size 0.74rem
            font-weight 400
            color lime
            margin 0
            letter-spacing 0.01em

        .arch__arrow
            height 24px
            margin-left 40px
            display flex
            align-items center

            span
                display block
                width 1.5px
                height 100%
                background hair-dark-strong
                position relative

                &::after
                    content ""
                    position absolute
                    left -3px
                    bottom -1px
                    width 6px
                    height 6px
                    border-right 1.5px solid lime
                    border-bottom 1.5px solid lime
                    transform rotate(45deg)

        .arch__side
            padding-left 36px
            border-left 1px solid hair-dark
            display flex
            flex-direction column
            gap 28px

        .arch__block
            h3
                font-family font-display
                font-weight 700
                font-size 1.02rem
                color light-ink
                margin 0

            p
                font-size 0.88rem
                color light-body
                line-height 1.46
                margin 0

            ul
                display flex
                flex-direction column
                gap 8px

                li
                    font-size 0.88rem
                    color light-body
                    padding-left 16px
                    position relative

                    &::before
                        content "—"
                        position absolute
                        left 0
                        color lime

        .arch__block--accent
            h3
                color lime

            p
                color light-ink

    // =========================================================================
    // 12 — Sequence Diagram (Crisp White High-Contrast Vector Diagram)
    // =========================================================================

    &[data-layout="sequence"]
        .sequence
            flex 1
            min-height 0
            display flex
            flex-direction column
            justify-content space-between
            gap 24px

        .sequence__svg
            width 100%
            max-height 58vh
            display block

        .sequence__facts
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 44px

        .sequence__fact
            padding-top 16px
            border-top 2px solid ink

            strong
                display block
                font-family font-display
                font-weight 700
                font-size 0.96rem
                color forest
                margin-bottom 4px

            p
                font-size 0.92rem
                color ink-body
                line-height 1.4
                margin 0

    // =========================================================================
    // 13 — Challenges & Solutions (Split 30/70 Unboxed Rows, Ref Pages 11 & 15)
    // =========================================================================

    &[data-layout="challenges"]
        .challenge-rows
            margin-top 40px
            display flex
            flex-direction column
            gap 32px

        .challenge-row
            display grid
            grid-template-columns 68px minmax(0, 1fr)
            gap 20px
            align-items baseline
            padding-top 22px
            border-top 1px solid hair-light

            &:first-child
                border-top none
                padding-top 0

        .challenge-row__idx
            font-family font-display
            font-weight 700
            font-size 2.2rem
            line-height 1
            color lime-mid
            font-variant-numeric tabular-nums

        .challenge-row__body
            h2
                font-family font-display
                font-weight 700
                font-size 1.24rem
                color ink
                margin 0 0 10px

            p
                font-size 0.92rem
                line-height 1.42
                margin 0 0 6px
                display grid
                grid-template-columns 84px minmax(0, 1fr)
                gap 12px

                &:last-child
                    margin-bottom 0

                span
                    font-family font-display
                    font-weight 700
                    font-size 0.74rem
                    letter-spacing 0.1em
                    text-transform uppercase
                    padding-top 3px

        .challenge-row__prob
            color ink-muted

            span
                color amber-light

        .challenge-row__sol
            color ink
            font-weight 500

            span
                color forest

    // =========================================================================
    // 15 — Plan / Ist Hours (Borderless Swiss Table + Risks + Dark Anchor Band)
    // =========================================================================

    &[data-layout="hours"]
        .hours
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1.65fr) minmax(300px, 0.9fr)
            gap 56px
            align-items start

        .hours__table
            width 100%
            border-collapse collapse

            th, td
                text-align left
                padding 15px 10px
                border-bottom 1px solid hair-light

            thead th
                font-family font-display
                font-weight 700
                font-size 0.78rem
                letter-spacing 0.1em
                text-transform uppercase
                color ink-muted
                border-bottom 2px solid ink
                padding-bottom 12px

                &:nth-child(3),
                &:nth-child(4),
                &:nth-child(5)
                    text-align right
                    width 96px

            tbody td
                font-size 0.96rem
                color ink

            tfoot tr.hours__total td
                border-top 2px solid ink
                border-bottom none
                padding-top 16px
                font-weight 700
                background mist

        .hours__code
            font-family font-mono
            font-size 0.78rem
            font-weight 600
            color forest
            width 78px

        .hours__pkg
            font-weight 500

        .hours__val
            text-align right !important
            font-family font-mono
            font-size 0.88rem !important
            color ink-muted !important
            font-variant-numeric tabular-nums

        .hours__risks
            border-left 1px solid hair-light
            padding-left 36px

        .hours__risks-title
            font-family font-display
            font-weight 700
            font-size 0.84rem
            letter-spacing 0.14em
            text-transform uppercase
            color ink
            margin 0 0 22px

        .hours__risk-list
            display flex
            flex-direction column
            gap 22px

        .hours__risk
            display grid
            grid-template-columns 36px minmax(0, 1fr)
            gap 12px
            align-items baseline

            h3
                font-family font-display
                font-weight 700
                font-size 1.02rem
                color ink
                margin 0 0 3px

            p
                font-size 0.88rem
                color ink-muted
                line-height 1.4
                margin 0

        .hours__risk-idx
            font-family font-mono
            font-weight 600
            font-size 0.84rem
            color amber-light

    // =========================================================================
    // 16 — Learnings & Reflection (Dark Open Canvas + Slanted Lime Dividers, Ref Page 28)
    // =========================================================================

    &[data-layout="learnings"]
        .learnings__cols
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1fr) 36px minmax(0, 1fr) 36px minmax(0, 1fr)
            gap 24px
            align-items center

        .learnings__col
            padding 16px 8px

            h2
                font-family font-display
                font-weight 700
                font-size 1.45rem
                line-height 1.2
                color light-ink
                margin 10px 0 0
                letter-spacing -0.015em

            p
                font-size 0.98rem
                font-weight 400
                color light-body
                line-height 1.56
                margin 0

        .learnings__tag
            font-family font-mono
            font-size 0.78rem
            font-weight 500
            color lime
            letter-spacing 0.03em

    // =========================================================================
    // 17 — Requirements, Tests & CI/CD (Crisp White Minimalist Charts, Ref Page 24)
    // =========================================================================

    &[data-layout="quality"]
        .quality
            margin auto 0
            display grid
            grid-template-columns minmax(0, 0.88fr) 1px minmax(0, 1.18fr)
            gap 48px
            align-items start

        .quality__divider
            width 1px
            height 100%
            min-height 380px
            background hair-light

        .quality__col
            display flex
            flex-direction column

        .quality__heading
            font-family font-display
            font-weight 700
            font-size 0.82rem
            letter-spacing 0.16em
            text-transform uppercase
            color ink-muted
            margin 0 0 22px

        .quality__kpis
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 28px
            margin-bottom 22px

        .quality__kpi
            border-top 2px solid ink
            padding-top 16px

            strong
                display block
                font-family font-display
                font-weight 800
                font-size clamp(2.8rem, 4vw, 3.6rem)
                line-height 1
                color forest
                font-variant-numeric tabular-nums

                span:last-child
                    font-weight 400
                    font-size 1.5rem
                    color ink-subtle

            em
                display block
                margin-top 8px
                font-style normal
                font-family font-display
                font-weight 500
                font-size 0.92rem
                color ink-body

        .audit__bar
            display flex
            height 10px
            width 100%
            gap 2px
            background mist
            margin-bottom 24px

        .audit__seg
            width var(--w)
            height 100%

            &.is-pass
                background forest
            &.is-partial
                background amber-light

        .quality__prog
            font-family font-display
            font-weight 600
            font-size 0.98rem
            color ink
            margin 0 0 10px

        .quality__note
            font-size 0.88rem
            color ink-muted
            line-height 1.48
            margin 0
            padding-left 14px
            border-left 2px solid amber-light

        .quality__test-head
            display flex
            align-items baseline
            justify-content space-between
            gap 16px
            margin-bottom 22px

            .quality__heading
                margin 0

        .quality__test-total
            font-family font-display
            font-size 0.98rem
            color ink-muted

            strong
                font-weight 800
                font-size 1.35rem
                color ink
                font-variant-numeric tabular-nums

        // Minimalist Horizontal Bar Chart (Ref Page 24)
        .qbar__list
            display flex
            flex-direction column
            gap 18px
            margin-bottom 28px

        .qbar__row
            display flex
            flex-direction column
            gap 6px

        .qbar__meta
            display flex
            justify-content space-between
            align-items baseline
            gap 12px

            strong
                font-family font-display
                font-weight 700
                font-size 0.94rem
                color ink

            span
                font-size 0.8rem
                color ink-muted

        .qbar__track
            display flex
            align-items center
            gap 12px
            height 22px

        .qbar__fill
            display block
            height 100%
            width calc(var(--w) * 0.84)
            min-width 18px
            background forest

        .qbar__count
            font-style normal
            font-family font-display
            font-weight 700
            font-size 0.94rem
            color ink
            font-variant-numeric tabular-nums

        .quality__ci
            padding-top 18px
            border-top 1px solid hair-light

        .quality__ci-label
            display block
            font-family font-display
            font-weight 700
            font-size 0.74rem
            letter-spacing 0.14em
            text-transform uppercase
            color forest
            margin-bottom 10px

        .quality__ci-steps
            display flex
            flex-wrap wrap
            align-items center
            gap 8px 18px

            li
                font-family font-mono
                font-size 0.78rem
                font-weight 500
                color ink
                position relative

                & + li::before
                    content "→"
                    position absolute
                    left -13px
                    color ink-subtle

        .quality__caveat
            margin 18px 0 0
            font-size 0.78rem
            color ink-muted

    // =========================================================================
    // 18 — Conclusion Statement (Split 38% Dark / 62% Crisp White)
    // =========================================================================

    &[data-layout="statement"]
        .statement__left
            padding 72px 64px 72px 88px

        .statement__lines
            margin 0
            display flex
            flex-direction column
            gap 6px
            font-family font-display
            font-weight 800
            font-size clamp(3rem, 5vw, 4.5rem)
            line-height 1.02
            letter-spacing -0.03em
            color light-ink

            .is-accent
                color lime

        .statement__right
            padding 72px 88px 72px 80px
            gap 40px

        .statement__group
            border-top 2px solid forest
            padding-top 20px

            h2
                font-family font-display
                font-weight 700
                font-size 0.84rem
                letter-spacing 0.16em
                text-transform uppercase
                color forest
                margin 0 0 18px

            ul
                display flex
                flex-direction column
                gap 14px

                li
                    font-family font-display
                    font-size 1.04rem
                    font-weight 400
                    color ink-body
                    line-height 1.42
                    padding-left 20px
                    position relative

                    &::before
                        content "—"
                        position absolute
                        left 0
                        color forest

            &.is-open
                border-top-color amber-light

                h2
                    color amber-light

                ul li::before
                    color amber-light

    // =========================================================================
    // 19 — Live-Demo (Dark Open Launchpad + Slanted Lime Rule)
    // =========================================================================

    &[data-layout="demo"]
        .demo
            margin auto 0
            display grid
            grid-template-columns minmax(0, 1.25fr) 36px minmax(320px, 0.95fr)
            gap 28px
            align-items center

        .demo__steps
            display flex
            flex-direction column
            border-top 1px solid hair-dark-strong

        .demo__step
            display grid
            grid-template-columns 48px minmax(0, 1fr)
            gap 16px
            align-items baseline
            padding 16px 0
            border-bottom 1px solid hair-dark

            strong
                display block
                font-family font-display
                font-weight 700
                font-size 1.12rem
                color light-ink
                margin-bottom 2px

            p
                font-size 0.9rem
                color light-muted
                line-height 1.38
                margin 0

        .demo__step-num
            font-family font-display
            font-weight 700
            font-size 1.15rem
            color lime
            font-variant-numeric tabular-nums

        .demo__prompt
            display flex
            flex-direction column
            padding-left 12px

        .demo__prompt-label
            font-family font-display
            font-weight 600
            font-size 0.78rem
            letter-spacing 0.2em
            text-transform uppercase
            color lime
            margin-bottom 14px

        .demo__prompt-q
            font-family font-display
            font-weight 800
            font-size clamp(2.1rem, 3.2vw, 3rem)
            line-height 1.08
            letter-spacing -0.025em
            color light-ink
            margin 0

        .demo__prompt-hint
            font-size 0.98rem
            color light-body
            line-height 1.48
            margin 4px 0 22px

        .demo__clues
            font-family font-mono
            font-size 0.78rem
            color lime
            letter-spacing 0.02em
            margin 0

    // =========================================================================
    // 20 — Closing Q&A (Dark Corporate Asymmetric Split, Ref Page 30)
    // =========================================================================

    &[data-layout="qa"]
        .qa
            width 100%
            height 100%
            position relative
            overflow hidden
            display flex
            align-items center

        .qa__inner
            position relative
            z-index 2
            width 100%
            max-width 1480px
            margin 0 auto
            padding 0 112px
            display grid
            grid-template-columns minmax(0, 1.1fr) 48px minmax(0, 0.9fr)
            gap 36px
            align-items center

        .qa__thanks
            font-family font-display
            font-weight 800
            font-size clamp(3.4rem, 6vw, 5.4rem)
            line-height 1
            letter-spacing -0.035em
            color light-ink
            margin 0

        .qa__question
            font-family font-display
            font-weight 700
            font-size clamp(2.6rem, 4.6vw, 4.1rem)
            line-height 1.06
            letter-spacing -0.025em
            color lime
            margin 12px 0 0

        .qa__slant
            min-height 260px

        .qa__right
            display flex
            flex-direction column
            gap 10px

        .qa__brand
            font-family font-display
            font-weight 800
            font-size 1.9rem
            letter-spacing -0.02em
            margin-bottom 8px

            span
                color light-ink

            em
                font-style normal
                color lime

        .qa__byline
            font-family font-display
            font-weight 500
            font-size 1.15rem
            color light-ink
            margin 0

        .qa__academic
            font-family font-display
            font-weight 400
            font-size 0.9rem
            letter-spacing 0.1em
            text-transform uppercase
            color light-muted
            margin 0

        .qa__hint
            margin 18px 0 0
            font-family font-mono
            font-size 0.72rem
            color light-subtle

    // =========================================================================
    // Appendix A1 — Clean Borderless 2-Column Requirements Matrix
    // =========================================================================

    &[data-layout="appendix-audit"]
        .audit__tables
            margin auto 0
            display grid
            grid-template-columns repeat(2, minmax(0, 1fr))
            gap 40px
            align-items start

        .audit__table
            width 100%
            border-collapse collapse

            th, td
                text-align left
                padding 7.5px 8px
                border-bottom 1px solid hair-light
                vertical-align middle

            thead th
                font-family font-display
                font-weight 700
                font-size 0.68rem
                letter-spacing 0.1em
                text-transform uppercase
                color ink-muted
                border-bottom 2px solid ink

                &:last-child
                    text-align right

            tbody td
                font-size 0.76rem
                color ink
                line-height 1.3

                &:last-child
                    text-align right

        .audit__nr
            font-family font-mono
            font-size 0.72rem !important
            color ink-subtle !important
            width 32px

        .audit__type
            font-family font-mono
            font-size 0.64rem !important
            color ink-muted !important
            white-space nowrap

        .audit__status
            font-family font-mono
            font-size 0.64rem !important
            font-weight 600
            text-transform uppercase
            letter-spacing 0.04em
            white-space nowrap

            &.is-umgesetzt
                color forest

            &.is-konfiguriert
                color amber-light

// =============================================================================
// 3D World Walk-Up Station Prompt (Minimal Matte)
// =============================================================================

.station-prompt
    position fixed
    left 50%
    bottom 9%
    transform translate(-50%, 8px)
    z-index 15
    display flex
    align-items center
    gap 10px
    padding 9px 18px
    border 1px solid hair-dark-strong
    background rgba(15, 16, 33, 0.90)
    color light-ink
    font-family font-display
    font-weight 600
    font-size 0.85rem
    letter-spacing 0.02em
    pointer-events none
    opacity 0
    transition opacity 0.22s ease, transform 0.22s ease

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

    &__key
        display flex
        align-items center
        justify-content center
        width 22px
        height 22px
        border 1px solid lime
        color lime
        font-family font-mono
        font-weight 500
        font-size 0.72rem

// =============================================================================
// Reduced Motion & Static 16:9 Print / PDF Export (?print=1)
// =============================================================================

@media (prefers-reduced-motion: reduce)
    .presentation,
    .presentation__scrim,
    .station-prompt
        transition none

@page
    size 1920px 1080px
    margin 0

html.is-print-deck,
html.is-print-deck body
    position static !important
    top auto !important
    left auto !important
    width 1920px !important
    height auto !important
    margin 0
    padding 0
    overflow visible !important
    background navy
    -webkit-print-color-adjust exact
    print-color-adjust exact

.print-deck
    display block
    width 1920px

.print-slide.presentation
    position relative
    inset auto
    width 1920px
    height 1080px
    overflow hidden
    opacity 1
    visibility visible
    break-after page
    page-break-after always
    break-inside avoid
    page-break-inside avoid

    &:last-child
        break-after auto
        page-break-after auto

    .hero__planet-stage
        width 390px
        height 390px
