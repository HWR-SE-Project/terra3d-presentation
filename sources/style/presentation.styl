// TerraGuessr presentation overlay (Phase 4)
// Palette mirrors ZoneIdentity.js (sources/Game/World/ZoneIdentity.js),
// itself sourced from the real TerraGuessr app's styles/index.css.

space = #14112a
space-deep = #0e0b20
space-light = #352d64
cream = #fbf7ee
lime = #c0f66b
lime-light = #d7ff96

.presentation
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    z-index 20
    pointer-events none
    opacity 0
    visibility hidden
    transition opacity 0.4s ease, visibility 0.4s ease
    font-family "Nunito", sans-serif
    color cream

    &.is-visible
        opacity 1
        visibility visible

    &__scrim
        position absolute
        inset 0
        background linear-gradient(115deg, alpha(space-deep, 0.88) 0%, alpha(space-light, 0.55) 38%, alpha(space-light, 0) 62%)

    &__stations
        position absolute
        top 28px
        left 50%
        transform translateX(-50%)
        display flex
        gap 10px
        pointer-events auto

        @media only screen and (max-width 640px)
            top 14px
            gap 6px

    &__station-dot
        display flex
        align-items center
        gap 8px
        padding 8px 14px
        border-radius 999px
        border 1px solid alpha(cream, 0.25)
        background alpha(space-deep, 0.55)
        color alpha(cream, 0.6)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.8rem
        letter-spacing 0.02em
        cursor pointer
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

        .presentation__station-index
            opacity 0.6

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color cream

        &.is-active
            border-color var(--accent, lime)
            color cream
            background alpha(space-light, 0.65)

            .presentation__station-index
                color var(--accent, lime)
                opacity 1

        @media only screen and (max-width 640px)
            padding 6px 10px
            font-size 0.7rem

            .presentation__station-title
                display none

    &__stage
        position absolute
        left 7%
        bottom 16%
        max-width 620px
        padding-right 24px

        @media only screen and (max-width 900px)
            left 5%
            right 5%
            bottom 22%
            max-width none

    &__eyebrow
        --accent lime
        display inline-block
        margin-bottom 0.6em
        padding 4px 14px
        border-radius 999px
        border 1px solid var(--accent)
        color var(--accent)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.85rem
        letter-spacing 0.08em
        text-transform uppercase

    &__title
        margin-bottom 0.35em
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 2.6rem
        line-height 1.08
        text-wrap balance

        @media only screen and (max-width 640px)
            font-size 1.8rem

    &__subtitle
        margin-bottom 0.9em
        font-size 1.15rem
        font-weight 600
        color lime-light
        opacity 0.9

        @media only screen and (max-width 640px)
            font-size 0.95rem

    &__body
        display flex
        flex-direction column
        gap 0.5em
        font-size 1rem
        line-height 1.45
        opacity 0.92
        list-style none

        li
            position relative
            padding-left 1.1em

            &::before
                content "—"
                position absolute
                left 0
                opacity 0.6

        @media only screen and (max-width 640px)
            font-size 0.88rem

    &__hints
        position absolute
        right 24px
        bottom 20px
        display flex
        flex-direction column
        align-items flex-end
        gap 4px
        font-size 0.72rem
        letter-spacing 0.02em
        color alpha(cream, 0.45)

        i
            font-style normal
            padding 1px 6px
            margin 0 2px
            border-radius 5px
            border 1px solid alpha(cream, 0.3)
            font-weight 600

        @media only screen and (max-width 640px)
            display none

    &__close
        position absolute
        top 24px
        right 24px
        display none
        align-items center
        justify-content center
        width 40px
        height 40px
        border-radius 50%
        border 1px solid alpha(cream, 0.3)
        background alpha(space-deep, 0.55)
        color cream
        font-size 1.5rem
        line-height 1
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, color 0.2s ease, background 0.2s ease

        html:not(.is-mode-touch) &:hover
            border-color alpha(cream, 0.5)
            color lime-light

        @media only screen and (max-width 640px)
            top 14px
            right 14px
            width 34px
            height 34px
            font-size 1.25rem

    &__section-nav
        display flex
        align-items center
        gap 1em
        margin-top 1em

    &__section-count
        font-size 0.8rem
        font-weight 600
        letter-spacing 0.03em
        color alpha(cream, 0.55)

    &__finish
        display none
        align-items center
        gap 8px
        padding 10px 20px
        border-radius 999px
        border 1.5px solid var(--accent, lime)
        background alpha(space-deep, 0.4)
        color cream
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 600
        font-size 0.85rem
        cursor pointer
        pointer-events auto
        transition border-color 0.2s ease, background 0.2s ease, transform 0.2s ease

        &.is-visible
            display inline-flex

        html:not(.is-mode-touch) &:hover
            background alpha(space-light, 0.6)
            transform translateY(-1px)

    // Mode-specific chrome: tour (automated, all stations) vs. station
    // (one stand opened by walking up and pressing the interact key).
    &[data-flow="station"]
        .presentation__close
            display flex

        .presentation__stations
            display none

        .presentation__hint--tour
            display none

    &[data-flow="tour"]
        .presentation__close
            display none

        .presentation__section-nav
            display none

        .presentation__hint--station
            display none

.station-prompt
    position fixed
    left 50%
    bottom 11%
    transform translate(-50%, 10px)
    z-index 15
    display flex
    align-items center
    gap 10px
    padding 10px 18px
    border-radius 999px
    border 1px solid alpha(cream, 0.3)
    background alpha(space-deep, 0.72)
    color cream
    font-family "Nunito", sans-serif
    font-weight 600
    font-size 0.95rem
    pointer-events none
    opacity 0
    transition opacity 0.25s ease, transform 0.25s ease
    --accent lime

    &.is-visible
        opacity 1
        transform translate(-50%, 0)

    &__key
        display flex
        align-items center
        justify-content center
        width 26px
        height 26px
        border-radius 8px
        border 1.5px solid var(--accent)
        color var(--accent)
        font-family "Fredoka", ui-rounded, sans-serif
        font-weight 700
        font-size 0.85rem

    @media only screen and (max-width 640px)
        bottom 16%
        font-size 0.8rem
        padding 8px 14px

        &__key
            width 22px
            height 22px
